{
  "name": "game-wiki-scout",
  "version": "0.1.0",
  "description": "MCP server that finds the right wiki for any video game and reads it, so AI models stop guessing game facts.",
  "type": "module",
  "bin": { "game-wiki-scout": "dist/stdio.js" },
  "main": "dist/stdio.js",
  "files": ["dist", "facts", "README.md", "LICENSE"],
  "scripts": {
    "facts": "node scripts/build-facts.mjs",
    "build": "npm run facts && tsc",
    "start": "node dist/stdio.js",
    "smoke": "npm run build && node scripts/smoke.mjs"
  },
  "engines": { "node": ">=18" },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "node-html-parser": "^9.0.7",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
